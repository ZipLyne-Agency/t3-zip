# Copy to scripts/t3zip.local.env (git ignores it) to set this machine's values.
# Every line is optional; scripts/t3zip-update.sh uses the default when one is unset.

# The app's bundle id. Changing it later makes macOS treat it as a new app with new data.
# T3ZIP_BUNDLE_ID="local.t3zip"

# A Developer ID from your keychain (`security find-identity -v -p codesigning`) and its team.
# Without one the app is signed ad hoc and macOS may ask for privacy grants after each update.
# T3ZIP_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
# T3ZIP_SIGN_TEAM="TEAMID1234"

# Node to build with; defaults to the first node on PATH.
# T3ZIP_NODE="/opt/homebrew/bin/node"

# Optional notice hooks: a script that shows banners (called with title, message), and a file
# that collects one JSON line per notice.
# T3ZIP_NOTIFY_HELPER="$HOME/bin/notify.sh"
# T3ZIP_ALERTS_FILE="$HOME/.cache/t3zip-alerts.jsonl"
